{
  "name": "dsh-archive-manager",
  "description": "Archived-session panel with unarchive and permanent delete for the DeepSeek Harness web GUI (JSONL persistence backend)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "ui",
    "archive",
    "unarchive",
    "session"
  ],
  "license": "MIT",
  "author": {
    "name": "zxsctxx",
    "url": "https://github.com/zxsctxx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxsctxx/dsh-archive-manager.git"
  },
  "homepage": "https://github.com/zxsctxx/dsh-archive-manager#readme",
  "bugs": {
    "url": "https://github.com/zxsctxx/dsh-archive-manager/issues"
  },
  "packageManager": "pnpm@10.9.2",
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}